# GRC Frontend Environment Configuration
# Copy this file to .env.local and update the values

NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Hata izleme (self-hosted Sentry) — boş bırakılırsa devre dışı kalır.
# NEXT_PUBLIC_SENTRY_DSN: tarayıcıdan gönderilen event'ler için (istemciye açık, gizli değil)
# SENTRY_DSN: sunucu/edge tarafı event'ler için
# Kurulum: https://develop.sentry.dev/self-hosted/ (docker-compose ile ayrı kurulum gerekir)
# NEXT_PUBLIC_SENTRY_DSN=http://xxxxx@sentry.kurumunuz.local/2
# SENTRY_DSN=http://xxxxx@sentry.kurumunuz.local/2
