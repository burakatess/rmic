// GRC (Risk Management & Internal Control) Database Schema
// PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USER & ROLE MANAGEMENT
// ==========================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  department   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  role                       Role               @relation(fields: [roleId], references: [id])
  roleId                     String
  ownedRisks                 Risk[]             @relation("RiskOwner")
  ownedControls              Control[]          @relation("ControlOwner")
  testPerformerControls      Control[]          @relation("ControlTestPerformer")
  reviewerControls           Control[]          @relation("ControlReviewer")
  ownedActions               Action[]           @relation("ActionOwner")
  auditLogs                  AuditLog[]
  refreshTokens              RefreshToken[]
  riskProposals              RiskProposal[]     @relation("RiskProposalRequester")
  addedControlScopes         ControlYearScope[] @relation("ControlYearScopeAddedBy")
  removedControlScopes       ControlYearScope[] @relation("ControlYearScopeRemovedBy")
  assignedScopeYears         ControlYearScope[] @relation("ScopeAssignee")
  secondControlledScopeYears ControlYearScope[] @relation("ScopeSecondController")

  createdSimMethodologies SimulationMethodology[]  @relation("SimMethodologyCreatedBy")
  createdRiskSimulations  RiskSimulation[]         @relation("RiskSimulationCreatedBy")
  createdSimScenarios     RiskSimulationScenario[] @relation("RiskSimScenarioCreatedBy")
  performedSimTransfers   RiskSimulationTransfer[] @relation("RiskSimTransferPerformedBy")

  directorateMemberships        DirectorateMembership[] @relation("DirectorateMembershipUser")
  createdDirectorateMemberships DirectorateMembership[] @relation("DirectorateMembershipCreatedBy")

  updatedAnnualPlanDrafts AnnualPlanDraft[] @relation("AnnualPlanDraftUpdatedBy")
  appliedAnnualPlanDrafts AnnualPlanDraft[] @relation("AnnualPlanDraftAppliedBy")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json // Permission list as JSON array
  users       User[]
  createdAt   DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ==========================================
// DIRECTORATE (İlgili Direktörlük — FK tabanlı)
// ==========================================

model Directorate {
  id       String  @id @default(cuid())
  name     String  @unique // "BT Ağ Yönetimi"
  code     String? @unique // "BT-AG"
  gmy      String? // Bağlı GMY bilgisi
  isActive Boolean @default(true)

  // Relations
  controls      Control[]               @relation("ControlDirectorate")
  findings      Finding[]               @relation("FindingDirectorate")
  actions       Action[]                @relation("ActionDirectorate")
  followUps     FindingFollowUp[]       @relation("FollowUpDirectorate")
  controlTests  ControlTest[]           @relation("ControlTestDirectorate")
  riskProposals RiskProposal[]          @relation("RiskProposalDirectorate")
  memberships   DirectorateMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Kullanıcı ↔ Direktörlük yetkilendirme ilişkisi ("Birimim" kapsamı). Çoka-çok:
// bir kullanıcı birden fazla direktörlükte yetkili olabilir. Yalnızca GÖRÜNTÜLEME
// kapsamı belirler — modül bazlı işlem izinleri (finding:view vb.) ayrıca uygulanır.
model DirectorateMembership {
  id            String      @id @default(cuid())
  user          User        @relation("DirectorateMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  directorate   Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)
  directorateId String

  createdAt   DateTime @default(now())
  createdBy   User?    @relation("DirectorateMembershipCreatedBy", fields: [createdById], references: [id])
  createdById String?

  @@unique([userId, directorateId])
  @@index([directorateId])
}

enum RiskProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Bir bulguyu karşılayan risk yoksa kullanıcı yeni risk tanımı önerir → admin onayına düşer
model RiskProposal {
  id            String             @id @default(cuid())
  finding       Finding?           @relation("FindingRiskProposals", fields: [findingId], references: [id], onDelete: SetNull)
  findingId     String?
  directorate   Directorate?       @relation("RiskProposalDirectorate", fields: [directorateId], references: [id])
  directorateId String?
  riskTanimi    String             @db.Text
  status        RiskProposalStatus @default(PENDING)
  requestedBy   User               @relation("RiskProposalRequester", fields: [requestedById], references: [id])
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([findingId])
  @@index([requestedById])
}

// ==========================================
// RISK MANAGEMENT
// ==========================================

model Risk {
  id          String     @id @default(cuid())
  riskId      String     @unique // R-2024-001
  kayitId     String? // Jira kayıt ID (eski sistem referansı)
  name        String
  description String     @db.Text
  status      RiskStatus @default(IDENTIFIED)
  ozet        String?    @db.Text // Özet / summary

  // Organizasyon
  ilgiliGmy String? // İlgili Genel Müdür Yardımcılığı
  surec     String? // Süreç
  altSurec  String? // Alt Süreç
  flagForIT Boolean @default(false) // Flag 4 IT

  // Owner
  owner         User    @relation("RiskOwner", fields: [ownerId], references: [id])
  ownerId       String
  riskSorumlusu String? // Risk Sorumlusu (serbest metin, LDAP gelince FK olacak)

  // Category
  category   RiskCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  // Etki Boyutları (1-5, ağırlıklı)
  finansalEtki          Int? // Finansal Etki (%30)
  itibarEtkisi          Int? // İtibar Etkisi (%30)
  regulasyonEtkisi      Int? // Regülasyon Etkisi (%20)
  musteriEtkisi         Int? // Müşteri Etkisi (%20)
  gizlilikEtkisi        Int? // Gizlilik Etkisi (%35, BT)
  butunlukEtkisi        Int? // Bütünlük Etkisi (%30, BT)
  erisilebilirlikEtkisi Int? // Erişilebilirlik Etkisi (%35, BT)

  // Hesaplanan Değerler
  etki     Float? // Ağırlıklı toplam etki
  olasilik Int? // Olasılık (1-5)

  // Doğal Risk
  dogalRiskPuani    Float? // etki * olasilik
  dogalRiskSkoru    Int? // 1-25
  dogalRiskSeviyesi String? // DÜŞÜK / ORTA / YÜKSEK / KRİTİK

  // Bütünleşik Kontrol
  butunlesikKontrolPuani    Float?
  butunlesikKontrolSkoru    Int?
  butunlesikKontrolSeviyesi String?

  // Kalıntı Risk
  kalintiRiskPuani    Float?
  kalintiRiskSkoru    Int?
  kalintiRiskSeviyesi String?

  // Risk İşleme
  riskIsleme      String? // KABUL / AZALT / TRANSFER / KAÇIN
  mutabakatTarihi DateTime?

  // Inherent Risk Scoring (geriye dönük uyumluluk)
  inherentProbability Int @default(1) // 1-5
  inherentImpact      Int @default(1) // 1-5
  inherentRiskScore   Int @default(1) // Auto-calculated: probability * impact

  // Residual Risk Scoring (after controls)
  residualProbability Int?
  residualImpact      Int?
  residualRiskScore   Int?

  // Risk Appetite
  riskAppetite    Int?
  isAboveAppetite Boolean @default(false)

  // Treatment Decision
  treatmentDecision   TreatmentDecision?
  treatmentApproval   Boolean            @default(false)
  treatmentApprovedBy String?
  treatmentApprovedAt DateTime?

  // Version Control
  version Int @default(1)

  // Relations
  controls       ControlRiskMapping[]
  findings       Finding[]
  linkedFindings Finding[]            @relation("FindingRisks")
  actions        Action[]
  regulations    RiskRegulation[]
  assessments    RiskAssessment[]
  history        RiskHistory[]
  processes      ProcessRisk[]
  systems        SystemRisk[]
  riskEntries    RiskEntry[]
  riskControls   RiskControlRisk[] // Risk Yönetimi Kontrolleri
  riskActions    RiskActionRisk[] // Risk Yönetimi Aksiyonları

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([categoryId])
}

model RiskCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String? // For UI display
  risks       Risk[]
  createdAt   DateTime @default(now())
}

model RiskAssessment {
  id             String   @id @default(cuid())
  risk           Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  riskId         String
  assessmentDate DateTime @default(now())
  assessor       String

  // Inherent Assessment
  probability   Int // 1-5
  impact        Int // 1-5
  inherentScore Int // probability * impact

  // Mitigating Controls
  mitigatingControlIds String[] // Control IDs

  // Residual Assessment (after controls selected)
  residualProbability Int?
  residualImpact      Int?
  residualScore       Int?

  // Treatment
  treatmentDecision TreatmentDecision?
  justification     String?            @db.Text

  createdAt DateTime @default(now())

  @@index([riskId])
}

model RiskHistory {
  id         String   @id @default(cuid())
  risk       Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  riskId     String
  version    Int
  changeType String // CREATE, UPDATE, ASSESSMENT, TREATMENT
  changeData Json
  changedBy  String
  changedAt  DateTime @default(now())

  @@index([riskId])
  @@index([changedAt])
}

// Process and System relations
model Process {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  risks       ProcessRisk[]
  createdAt   DateTime      @default(now())
}

model ProcessRisk {
  id        String  @id @default(cuid())
  process   Process @relation(fields: [processId], references: [id])
  processId String
  risk      Risk    @relation(fields: [riskId], references: [id])
  riskId    String

  @@unique([processId, riskId])
}

model System {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  risks       SystemRisk[]
  createdAt   DateTime     @default(now())
}

model SystemRisk {
  id       String @id @default(cuid())
  system   System @relation(fields: [systemId], references: [id])
  systemId String
  risk     Risk   @relation(fields: [riskId], references: [id])
  riskId   String

  @@unique([systemId, riskId])
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  TREATED
  ACCEPTED
  CLOSED
}

enum TreatmentDecision {
  ACCEPT
  MITIGATE
  TRANSFER
  AVOID
}

// ==========================================
// CONTROL MANAGEMENT
// ==========================================

model Control {
  id            String            @id @default(cuid())
  controlId     String            @unique // Kalıcı görüntü kodu — BTK-XXXX (control_code_seq); eski K-YYYY-NNNN değerleri CodeAlias'ta saklanır
  name          String
  description   String            @db.Text
  type          ControlType
  nature        ControlNature
  automation    ControlAutomation
  frequency     ControlFrequency
  controlPeriod String? // For QUARTERLY, SEMI_ANNUAL, ANNUAL
  controlDate   DateTime? // For AD_HOC controls

  // Operational Status
  status ControlStatus @default(ACTIVE)

  // Extended operational fields
  directorate    String? // Legacy: serbest metin (geriye dönük uyumluluk)
  directorateId  String? // FK: Directorate tablosu
  gmy            String? // İlgili Genel Müdür Yardımcılığı
  mehaz          String? // Mehaz / Dayanak
  testSteps      String?  @db.Text // Test adımları
  notes          String?  @db.Text // Notlar
  selectedMonths String[] // Seçili aylar (3 Aylık, 6 Aylık, Yıllık, Arızi)

  // Owner — kaydı oluşturan/idari sahip. ARTIK "atanan kontrolcü" DEĞİL —
  // create() içinde userId (oluşturan) ile sabitlenir, DTO'dan yazılamaz.
  // Test kontrolcüsü ataması yıl bazlı: bkz. ControlYearScope.assigneeId.
  owner   User   @relation("ControlOwner", fields: [ownerId], references: [id])
  ownerId String

  // LEGACY test rolleri — yeni create/update yollarından artık yazılmaz,
  // yalnızca geriye dönük okuma için tutulur. Yıl bazlı atama için bkz.
  // ControlYearScope.assigneeId / secondControllerId.
  testPerformer      User?   @relation("ControlTestPerformer", fields: [testPerformerId], references: [id])
  testPerformerId    String?
  reviewer           User?   @relation("ControlReviewer", fields: [reviewerId], references: [id])
  reviewerId         String?
  secondControllerId String? // LEGACY — 2. Kontrolcü (bkz. yukarıdaki not)
  contactPersonId    String? // İletişim Kişisi (LDAP) — canlı kalır, ayrı bir kavram

  // Effectiveness
  effectivenessStatus EffectivenessStatus @default(NOT_TESTED)
  lastTestDate        DateTime?
  lastTestResult      TestResult?

  // Relations
  directorateRel       Directorate?          @relation("ControlDirectorate", fields: [directorateId], references: [id])
  risks                ControlRiskMapping[]
  regulations          ControlRegulation[]
  tests                ControlTest[]
  findings             Finding[]
  actions              Action[]
  sourceMappings       SourceMapping[] // Kaynak Kataloğu eşleştirmeleri (çoktan çoğa)
  testCards            ControlTestCard[] // İlişkili kontrol test kartları
  yearScopes           ControlYearScope[] // Yıllık kapsam kayıtları (ayrı yaşam döngüsü)
  annualPlanDraftItems AnnualPlanDraftItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([testPerformerId])
  @@index([reviewerId])
  @@index([effectivenessStatus])
  @@index([status])
  @@index([directorateId])
}

// Kontrol–yıl ilişkisi: Control kalıcı ana envanterdir, bu model o kontrolün
// hangi yıl(lar)ın kapsamına alındığını, o yıla özel periyodiklik/planlama
// ayarlarını ve kapsamdan çıkarma geçmişini (satır silinmeden) tutar.
model ControlYearScope {
  id        String  @id @default(cuid())
  control   Control @relation(fields: [controlId], references: [id])
  controlId String
  year      Int

  status ControlYearScopeStatus @default(ACTIVE)

  // Bu yıla özel planlama ayarları — Control.frequency'den bağımsız değişebilir,
  // envanterdeki varsayılan periyodiklik değişikliği geçmiş yılları etkilemez.
  frequency      ControlFrequency
  referenceMonth Int? // 1-12 — QUARTERLY/SEMI_ANNUAL/ANNUAL için kullanıcı seçimi; selectedMonths bundan türetilir
  selectedMonths String[] // AD_HOC / özel ay listesi — periyodik sıklıklar için backend'de referenceMonth'tan hesaplanır
  controlDate    DateTime? // AD_HOC tekil tarih

  // Bu yılın test kontrolcü atamaları — Control'den bağımsız, yıl bazlı.
  assignee           User?   @relation("ScopeAssignee", fields: [assigneeId], references: [id])
  assigneeId         String?
  secondController   User?   @relation("ScopeSecondController", fields: [secondControllerId], references: [id])
  secondControllerId String?

  addedBy   User     @relation("ControlYearScopeAddedBy", fields: [addedById], references: [id])
  addedById String
  addedAt   DateTime @default(now())

  removedBy     User?     @relation("ControlYearScopeRemovedBy", fields: [removedById], references: [id])
  removedById   String?
  removedAt     DateTime?
  removalReason String?   @db.Text

  copiedFromYear Int? // "önceki yıldan kopyala" ile oluşturulduysa kaynak yıl

  tasks ControlTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([controlId, year])
  @@index([year])
  @@index([status])
  @@index([assigneeId])
  @@index([secondControllerId])
}

enum ControlYearScopeStatus {
  ACTIVE
  REMOVED
}

// Yıllık Plan — taslak katmanı. Gerçek ControlYearScope/ControlTest'i ASLA
// doğrudan değiştirmez; yalnızca "Planı Uygula" ControlScopeService'in aynı
// motoruyla gerçek kapsamı günceller. Yıl başına TEK paylaşılan taslak
// (kullanıcı başına değil) — birden fazla yetkili aynı taslağı düzenleyebilir,
// `revision` ile iyimser eşzamanlılık korunur (ControlTest.contentVersion ile
// aynı desen).
model AnnualPlanDraft {
  id       String                @id @default(cuid())
  year     Int                   @unique
  revision Int                   @default(0)
  status   AnnualPlanDraftStatus @default(OPEN)

  updatedBy   User   @relation("AnnualPlanDraftUpdatedBy", fields: [updatedById], references: [id])
  updatedById String

  lastAppliedAt   DateTime?
  lastAppliedBy   User?     @relation("AnnualPlanDraftAppliedBy", fields: [lastAppliedById], references: [id])
  lastAppliedById String?

  items AnnualPlanDraftItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AnnualPlanDraftStatus {
  OPEN
  APPLIED
}

// Taslaktaki tek kontrol satırının önerilen (henüz uygulanmamış) durumu.
// `inScope=false` + gerçek ACTIVE kapsam var demek "kapsamdan çıkarılacak";
// `inScope=true` + gerçek kapsam yok demek "eklenecek" — fark, apply anında
// gerçek ControlYearScope ile karşılaştırılarak (stored değil, hesaplanarak)
// belirlenir.
model AnnualPlanDraftItem {
  id      String          @id @default(cuid())
  draft   AnnualPlanDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId String

  control   Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  controlId String

  inScope        Boolean
  frequency      ControlFrequency?
  referenceMonth Int? // 1-12 — QUARTERLY/SEMI_ANNUAL/ANNUAL referans ay seçimi
  selectedMonths String[]
  controlDate    DateTime? // yalnızca AD_HOC
  reason         String?           @db.Text // sıklık/takvim/atama değişikliği gerekçesi

  // Bu yılın taslak kontrolcü atamaları — plain string (Control gibi FK
  // doğrulaması servis katmanında yapılır, draft satırı hafif kalır).
  assigneeId         String?
  secondControllerId String?

  updatedAt DateTime @updatedAt

  @@unique([draftId, controlId])
  @@index([controlId])
}

// Eski kod → yeni kod eşlemesi (Control: K-YYYY-NNNN → BTK-XXXX; ControlTest:
// TST-YYYY-NNNN → YYYY-BTK-XXXX-TN). Tek tablo iki entityType'ı da karşılar —
// polimorfik FK Prisma'da temiz temsil edilemediği için entityId düz string,
// doğrulama uygulama katmanında yapılır (bu şemada zaten var olan
// removedById/outOfScopeById gibi plain-string çapraz referans deseniyle tutarlı).
model CodeAlias {
  id         String   @id @default(cuid())
  entityType String // 'CONTROL' | 'CONTROL_TEST'
  entityId   String
  oldCode    String
  newCode    String
  source     String   @default("MIGRATION") // 'MIGRATION' | 'MANUAL'
  mappedAt   DateTime @default(now())
  mappedById String?

  @@unique([entityType, oldCode])
  @@index([entityType, entityId])
  @@index([newCode])
}

model ControlRiskMapping {
  id          String  @id @default(cuid())
  control     Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  controlId   String
  risk        Risk    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  riskId      String
  mappingType String  @default("PRIMARY") // PRIMARY, SECONDARY

  createdAt DateTime @default(now())

  @@unique([controlId, riskId])
  @@index([riskId])
}

// Birleştirilmiş test modeli (eski ControlTest + TestRecord → tek model)
model ControlTest {
  id        String  @id @default(cuid())
  testNo    String  @unique // T-YYYY-XXXX (otomatik)
  control   Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  controlId String

  // Yıllık kapsam ilişkisi — nullable: geçiş öncesi (legacy) kayıtlar güvenilir
  // şekilde eşleştirilemediyse NULL bırakılır (bkz. migrate-control-scopes.ts),
  // yeni oluşturulan her task servis katmanında daima scope ile yaratılır.
  scope   ControlYearScope? @relation(fields: [scopeId], references: [id])
  scopeId String?
  year    Int? // denormalize (scope.year) — filtre performansı

  // Dönem (frekansa göre): "YEAR","H1","H2","Q1".."Q4","M01".."M12","W01".."W53","ADHOC"
  periodKey   String?
  periodLabel String?
  periodStart DateTime?
  periodEnd   DateTime?

  // Kapsamdan çıkarma nedeniyle iptal (bkz. ControlTestStatus.KAPSAM_DISI)
  outOfScopeAt     DateTime?
  outOfScopeById   String?
  outOfScopeReason String?   @db.Text

  // Planlama
  plannedDate     DateTime // Test yapılması planlanan tarih
  isAutoGenerated Boolean  @default(false) // Frekansa göre otomatik mi?
  sprint          String?

  // Atama
  assigneeId         String?
  secondControllerId String?

  // Direktörlük (FK)
  directorate   Directorate? @relation("ControlTestDirectorate", fields: [directorateId], references: [id])
  directorateId String?

  // İçerik
  summary          String?
  description      String?  @db.Text
  resultText       String?  @db.Text // Kontrol sonucu açıklaması
  evidenceSummary  String?  @db.Text // Kanıt özeti
  evidenceUrls     String[] // Kanıt URL listesi
  stepObservations Json? // Test adımı bazlı gözlem/kanıt ilişkisi (opsiyonel) — [{index,text,observation,attachmentId?}]

  // İyimser eşzamanlılık — taslak kaydetmede iki sekme/kullanıcının birbirini
  // sessizce ezmesini önlemek için (bkz. controls/testing/[id] sayfası).
  contentVersion Int @default(0)

  // Statü
  status        ControlTestStatus  @default(BEKLIYOR)
  findingStatus FindingTestStatus? // Tamamlanınca dolar

  // İkinci Kontrolcü Onay Akışı — TAMAMLANDI = onaya gönderildi (bkz. enum yorumu)
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String? // Geri gönderme gerekçesi (zorunlu)
  returnedById    String? // Geri gönderen ikinci kontrolcü
  returnedAt      DateTime?

  // Final onaydan sonra iptal — yalnızca SYSTEM_ADMIN
  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  // Devam eden açık bulguya "referans" ile ilerletme (Madde 6) — basit tek-referans
  // ilişki: bir test en fazla bir açık bulguyu referans alabilir. Çoklu referans
  // ihtiyacı doğarsa ayrı bir ilişki tablosuna (ControlTestFindingReference)
  // geçilebilir; şu an için en basit/güvenli çözüm tercih edildi.
  referencedFinding   Finding? @relation("ControlTestFindingReference", fields: [referencedFindingId], references: [id])
  referencedFindingId String?
  referenceReason     String?  @db.Text

  // Tarihler
  completedAt DateTime?

  // İlgili bulgular
  findings Finding[]

  // Kanıt dosya ekleri
  attachments ControlTestAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scopeId, periodKey])
  @@index([controlId])
  @@index([status])
  @@index([plannedDate])
  @@index([directorateId])
  @@index([assigneeId])
  @@index([secondControllerId])
  @@index([referencedFindingId])
  @@index([scopeId])
  @@index([year])
}

enum ControlTestStatus {
  BEKLIYOR // Henüz başlanmadı
  DEVAM_EDIYOR // Test yürütülüyor
  TAMAMLANDI // Test bitti, 2. kontrolcü onayına gönderildi (ONAYA_GONDERILDI ile eşdeğer —
  // ayrı bir statü eklenmedi, mevcut TAMAMLANDI zaten bu anlamı taşıyordu)
  GERI_GONDERILDI // 2. kontrolcü düzeltme için geri gönderdi
  ONAYLANDI // 2. kontrolcü onayladı — final
  IPTAL // Final onaydan sonra SYSTEM_ADMIN tarafından iptal edildi
  KAPSAM_DISI // Kapsamdan çıkarma nedeniyle iptal (IPTAL'den farklı: final onay sonrası admin iptali değil)
}

enum FindingTestStatus {
  BULGUSU_YOK // Kontrol etkin
  BULGUSU_VAR // Bulgu tespit edildi
}

enum ControlType {
  IT_GENERAL // Legacy - maps to BT
  IT_APPLICATION // Legacy - maps to BT
  OPERATIONAL // Legacy - maps to BT_DISI
  FINANCIAL // Legacy - maps to BT_DISI
  COMPLIANCE // Legacy - maps to BT_DISI
  BT // New: IT Controls
  BT_DISI // New: Non-IT Controls
}

enum ControlNature {
  PREVENTIVE
  DETECTIVE
}

enum ControlAutomation {
  MANUAL
  AUTOMATED
  SEMI_AUTOMATED
}

enum ControlFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  AD_HOC
}

enum ControlStatus {
  ACTIVE
  PASSIVE
}

enum EffectivenessStatus {
  NOT_TESTED
  EFFECTIVE
  INEFFECTIVE
  PARTIALLY_EFFECTIVE
}

enum TestResult {
  EFFECTIVE
  INEFFECTIVE
  PARTIALLY_EFFECTIVE
}

enum ApprovalStatus {
  DRAFT // Taslak
  PENDING_APPROVAL // Onay bekliyor
  APPROVED // Onaylandı  
  REJECTED // Reddedildi
}

// TestRecord kaldırıldı — ControlTest'e absorbe edildi (Adım 12)

// ==========================================
// AUDIT & FINDINGS
// ==========================================

model AuditPlan {
  id         String          @id @default(cuid())
  planId     String          @unique // AP-2024-001
  name       String
  year       Int
  periodType PeriodType
  objectives String          @db.Text
  scope      String          @db.Text
  status     AuditPlanStatus @default(DRAFT)

  // Linked entities (stored as IDs)
  riskIds    String[]
  controlIds String[]

  // Planlama detayları (Design System v2 / audits-plans UI)
  auditedUnit      String?
  auditTeam        String?
  teamLeader       String?
  teamSize         Int?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  phase            AuditPlanPhase      @default(PLANNING)
  rationale        AuditPlanRationale?
  priority         AuditPlanPriority   @default(MEDIUM)
  plannedManDays   Int?
  actualManDays    Int?
  delayStatus      AuditDelayStatus    @default(ON_TRACK)
  draftReportDate  DateTime?
  finalReportDate  DateTime?

  // Relations
  executions AuditExecution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([status])
}

model AuditExecution {
  id          String               @id @default(cuid())
  executionId String?              @unique // AE-2024-001
  auditPlan   AuditPlan            @relation(fields: [auditPlanId], references: [id])
  auditPlanId String
  startDate   DateTime
  endDate     DateTime?
  auditor     String
  status      AuditExecutionStatus @default(IN_PROGRESS)
  progress    Int                  @default(0) // 0-100
  workpapers  Int                  @default(0)

  // Test results stored as JSON
  controlTests Json? // [{controlId, result, evidence, notes}]

  // Relations
  findings Finding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditPlanId])
  @@index([status])
}

model Finding {
  id          String          @id @default(cuid())
  findingId   String          @unique // 2026.BT.01
  description String          @db.Text
  impact      String          @db.Text
  severity    FindingSeverity
  isRecurrent Boolean         @default(false)
  status      FindingStatus   @default(IN_PROGRESS)
  findingType FindingType?
  summary     String?
  gmy         String?

  // Assignee
  assigneeId String? // User id reference

  // Direktörlük (FK)
  directorateRel Directorate? @relation("FindingDirectorate", fields: [directorateId], references: [id])
  directorateId  String?

  // Optional relations
  risk      Risk?    @relation(fields: [riskId], references: [id])
  riskId    String?
  control   Control? @relation(fields: [controlId], references: [id])
  controlId String?

  // ControlTest bağlantısı (TestRecord yerine)
  controlTest   ControlTest? @relation(fields: [controlTestId], references: [id])
  controlTestId String?

  // Many-to-many with Risks
  linkedRisks Risk[] @relation("FindingRisks")

  // Optional audit execution link
  auditExecution   AuditExecution? @relation(fields: [auditExecutionId], references: [id])
  auditExecutionId String?

  // Mutabakat akışı
  workflowStatus   FindingWorkflowStatus   @default(TASLAK)
  resolutionStatus FindingResolutionStatus @default(DEVAM_EDIYOR)
  iletisimKisisi   String?

  // Extended detail fields
  source                    FindingSource @default(INTERNAL_AUDIT)
  affectedSystem            String?
  recommendation            String?       @db.Text
  managementResponse        String?       @db.Text // alias: birimCevabi
  birimCevabi               String?       @db.Text // Birim Cevabı
  internalControlAssessment String?       @db.Text
  currentStatusDetail       String?       @db.Text
  targetResolutionDate      DateTime? // Hesaplamalı: MAX(open actions.dueDate)
  closedDate                DateTime?
  testDate                  DateTime?
  sendEmail                 Boolean       @default(false)
  relatedDepartment         String? // Legacy: free-text direktörlük
  responsiblePerson         String?

  // Relations
  actions          Action[]
  followUps        FindingFollowUp[]
  statusHistory    FindingStatusHistory[]
  attachments      FindingAttachment[]
  statusLogs       FindingStatusLog[]
  riskProposals    RiskProposal[]         @relation("FindingRiskProposals")
  // Bu bulguyu "referans" alarak ilerletilmiş sonraki kontrol testleri (Madde 6)
  referencingTests ControlTest[]          @relation("ControlTestFindingReference")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riskId])
  @@index([controlId])
  @@index([controlTestId])
  @@index([directorateId])
  @@index([status])
  @@index([severity])
  @@index([assigneeId])
  @@index([workflowStatus])
  @@index([resolutionStatus])
}

enum FindingSource {
  INTERNAL_AUDIT
  EXTERNAL_AUDIT
  CONTROL_TEST
  INCIDENT
  SELF_ASSESSMENT
  OTHER
}

enum PeriodType {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
}

enum AuditPlanStatus {
  DRAFT
  APPROVED
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditExecutionStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum AuditPlanPhase {
  PLANNING
  FIELDWORK
  REPORTING
  CLOSED
}

enum AuditPlanRationale {
  PERIODIC
  REGULATORY
  MANAGEMENT_REQUEST
  RISK_BASED
}

enum AuditPlanPriority {
  LOW
  MEDIUM
  HIGH
}

enum AuditDelayStatus {
  ON_TRACK
  AT_RISK
  DELAYED
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Mutabakat iş akışı statüsü (Jira BE projesi akışı)
enum FindingWorkflowStatus {
  TASLAK // İKS oluşturdu, birim göremez
  MUTABAKATA_GONDERILDI // İKS → Birim: e-posta gönderildi
  IC_KONTROL_ONAYINA_GONDERILDI // Birim yanıtladı → İKS onayına gönderildi
  MUTABAKAT_YAPILDI // İKS onayladı
  IPTAL // İKS Business Owner tarafından iptal
}

// Bulgunun gerçek çözüm durumu (resolution state)
enum FindingResolutionStatus {
  DEVAM_EDIYOR // Aksiyon henüz tamamlanmadı
  KISMEN_KAPATILDI // Kısmen kapatıldı, izleme devam ediyor
  KAPATILDI // Tamamen kapatıldı
  ERTELENDI // Test tarihi ertelendi
  YENI_AKSIYON_GEREKLI // Yeni düzeltici aksiyon açılması gerekiyor
}

enum FindingStatus {
  OPEN // Legacy
  IN_PROGRESS // Devam Ediyor
  PARTIALLY_CLOSED // Kısmen Kapatıldı
  PENDING_REVIEW // Legacy
  CLOSED // Kapatıldı
  VERIFIED // Legacy
}

enum FindingType {
  BT // Bilgi Teknolojileri Birimleri Bulgusu
  IB // İş Birimleri Bulgusu
  // Legacy values
  CONTROL_DEFICIENCY
  PROCESS_GAP
  COMPLIANCE_ISSUE
  DOCUMENTATION
  IT_SECURITY
  OPERATIONAL
}

// ==========================================
// FINDING FOLLOW-UP STUDIES (Bulgu Takip Çalışmaları)
// ==========================================

model FindingFollowUp {
  id         String  @id @default(cuid())
  followUpId String  @unique // 2026.03.BT.01
  finding    Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId  String

  // Linked corrective action (which action triggered this follow-up)
  action   Action? @relation(fields: [actionId], references: [id])
  actionId String?

  status               FollowUpStatus @default(BEKLIYOR)
  plannedDate          DateTime? // = Action.dueDate when auto-generated
  targetResolutionDate DateTime?
  testDate             DateTime?

  // Bu takip çalışmasında verilen bulgu durumu kararı
  resolutionOutcome FindingResolutionStatus?
  // Erteleme durumunda yeni takip tarihi
  newFollowUpDate   DateTime?

  // Evaluation (filled during follow-up)
  evaluatorId String? // Kim değerlendirdi
  evaluatedAt DateTime? // Ne zaman değerlendirdi
  result      FollowUpResult? // YETERLI / YETERSIZ / YENI_AKSIYON_GEREKLI
  explanation String?         @db.Text // Değerlendirme açıklaması

  // Approval
  approvalStatus FollowUpApprovalStatus? @default(BEKLIYOR)
  approvedBy     String?
  approvedAt     DateTime?

  // Direktörlük (FK)
  directorate   Directorate? @relation("FollowUpDirectorate", fields: [directorateId], references: [id])
  directorateId String?

  // Content
  birimCevabi               String? @db.Text
  currentStatusDetail       String? @db.Text
  internalControlAssessment String? @db.Text
  notes                     String? @db.Text
  secondControllerId        String?
  sprint                    String?

  // Yeni aksiyon
  newActionRequired Boolean @default(false)
  newActionId       String?

  // Attachments
  attachments          FollowUpAttachment[]
  statusHistoryEntries FindingStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId])
  @@index([actionId])
  @@index([directorateId])
  @@index([status])
  @@index([result])
}

enum FollowUpStatus {
  BEKLIYOR
  DEVAM_EDIYOR
  TAMAMLANDI
  ONAYLANDI
}

enum FollowUpResult {
  YETERLI
  YETERSIZ
  YENI_AKSIYON_GEREKLI // Yeni düzeltici aksiyon açılması gerekiyor
}

enum FollowUpApprovalStatus {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}

// ==========================================
// FINDING STATUS HISTORY (Append-only, cronolojik geçmiş)
// ==========================================

model FindingStatusHistory {
  id String @id @default(cuid())

  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String

  followUp   FindingFollowUp? @relation(fields: [followUpId], references: [id])
  followUpId String?

  action   Action? @relation(fields: [actionId], references: [id])
  actionId String?

  // Entry content
  entryDate     DateTime        @default(now())
  evaluator     String? // Kim yazdı / değerlendirdi
  result        FollowUpResult?
  explanation   String?         @db.Text
  evidenceLinks String?

  // Audit trail — işlem tipi ve değer değişiklikleri
  operation String? // FINDING_CREATED | FINDING_UPDATED | STATUS_CHANGED |
  // ACTION_ADDED | ACTION_UPDATED | ACTION_CLOSED |
  // FOLLOWUP_OPENED | FOLLOWUP_COMPLETED |
  // TEST_DATE_CHANGED | TARGET_DATE_CHANGED |
  // FILE_UPLOADED | FILE_DELETED |
  // FINDING_CLOSED | FINDING_REOPENED |
  // WORKFLOW_CHANGE | RESOLUTION_CHANGED
  userId    String? // İşlemi yapan kullanıcı
  fieldName String? // Hangi alan değişti
  oldValue  Json? // Eski değer
  newValue  Json? // Yeni değer

  // Mutabakat akışı geçiş kaydı (backward compat)
  changeType             String? // Eski alan, operation ile eşdeğer
  workflowStatus         FindingWorkflowStatus? // Yeni durum
  previousWorkflowStatus FindingWorkflowStatus? // Önceki durum
  resolutionStatus       FindingResolutionStatus? // Çözüm durumu değişikliği

  createdAt DateTime @default(now())

  @@index([findingId])
  @@index([followUpId])
  @@index([entryDate])
  @@index([operation])
  @@index([userId])
}

// ==========================================
// ACTION MANAGEMENT
// ==========================================

model Action {
  id          String @id @default(cuid())
  actionId    String @unique // A-2026-001
  description String @db.Text

  // Action always belongs to a Finding (iş kuralı)
  finding   Finding @relation(fields: [findingId], references: [id])
  findingId String

  // Optional: inherited context from Finding
  control   Control? @relation(fields: [controlId], references: [id])
  controlId String?
  risk      Risk?    @relation(fields: [riskId], references: [id])
  riskId    String?

  // Responsibility
  owner                 User         @relation("ActionOwner", fields: [ownerId], references: [id])
  ownerId               String
  responsibleDepartment String? // Legacy free-text
  directorate           Directorate? @relation("ActionDirectorate", fields: [directorateId], references: [id])
  directorateId         String?

  // Status & Dates
  status      ActionStatus @default(BEKLIYOR)
  dueDate     DateTime // Hedef Tamamlanma Tarihi
  completedAt DateTime?

  // Content
  notes String? @db.Text

  // Extension tracking
  extensionReason   String? @db.Text
  extensionApproved Boolean @default(false)

  // Attachments
  attachments ActionAttachment[]

  // Follow-ups generated for this action
  followUps            FindingFollowUp[]
  statusHistoryEntries FindingStatusHistory[]

  // Legacy: kept for backward compat with EffectivenessReview
  effectivenessReview EffectivenessReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([findingId])
  @@index([ownerId])
  @@index([directorateId])
  @@index([status])
  @@index([dueDate])
}

model EffectivenessReview {
  id       String @id @default(cuid())
  action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId String @unique

  riskScoreBefore      Int
  riskScoreAfter       Int
  controlEffectiveness EffectivenessStatus

  isEffective Boolean
  reviewedBy  String
  reviewedAt  DateTime @default(now())

  // Management Approval
  managementApproval Boolean   @default(false)
  approvedBy         String?
  approvedAt         DateTime?

  notes String? @db.Text
}

enum ActionStatus {
  BEKLIYOR
  DEVAM_EDIYOR
  TAMAMLANDI
  YETERSIZ
  KAPATILDI
  // Legacy (backward compat)
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
  OVERDUE
}

// ==========================================
// UNIFIED ATTACHMENT MODEL (Polimorfik — tek tablo, tüm entity'ler)
// ==========================================

model Attachment {
  id           String               @id @default(cuid())
  fileName     String // storage dosya adı
  originalName String // kullanıcının yüklediği orijinal isim
  mimeType     String // "application/pdf", "image/png" vb.
  sizeBytes    Int // byte cinsinden boyut
  filePath     String? // storage path (sonraki sprint)
  entityType   AttachmentEntityType
  entityId     String // ilgili kaydın ID'si
  uploadedById String? // userId

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([uploadedById])
}

enum AttachmentEntityType {
  CONTROL
  CONTROL_TEST
  FINDING
  CORRECTIVE_ACTION
  FINDING_FOLLOW_UP
}

// ==========================================
// LEGACY ATTACHMENT MODELLERI (Geriye dönük uyumluluk — yeni kod Attachment kullanmalı)
// ==========================================

model FindingAttachment {
  id           String   @id @default(cuid())
  finding      Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId    String
  fileName     String // storage dosya adı (uuid.pdf)
  originalName String // kullanıcının yüklediği orijinal isim
  mimeType     String // "application/pdf", "image/png" vb.
  sizeBytes    Int // dosya boyutu (byte)
  url          String? // gelecekte storage URL; şimdilik null
  uploadedBy   String? // userId
  createdAt    DateTime @default(now())

  @@index([findingId])
}

model ActionAttachment {
  id           String   @id @default(cuid())
  action       Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  actionId     String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String?
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@index([actionId])
}

model FollowUpAttachment {
  id           String          @id @default(cuid())
  followUp     FindingFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  followUpId   String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String?
  uploadedBy   String?
  createdAt    DateTime        @default(now())

  @@index([followUpId])
}

model ControlTestAttachment {
  id            String      @id @default(cuid())
  controlTest   ControlTest @relation(fields: [controlTestId], references: [id], onDelete: Cascade)
  controlTestId String
  fileName      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  url           String?
  uploadedBy    String?
  createdAt     DateTime    @default(now())

  @@index([controlTestId])
}

// Bulgunun güncel durum log'u — append-only, üzerine yazılmaz
model FindingStatusLog {
  id         String   @id @default(cuid())
  finding    Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId  String
  entryDate  DateTime @default(now())
  text       String   @db.Text // "Aksiyon tamamlandı ancak kanıt yetersiz bulundu."
  authorId   String? // userId — kim yazdı
  authorName String? // görüntüleme için isim
  followUpId String? // hangi takip çalışmasından geldi (opsiyonel)

  @@index([findingId])
  @@index([entryDate])
}

// ==========================================
// COMPLIANCE & REGULATION
// ==========================================

model Regulation {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  description   String?   @db.Text
  issuer        String?
  publishDate   DateTime?
  effectiveDate DateTime?
  status        String    @default("ACTIVE")
  isActive      Boolean   @default(true)

  // Relations
  articles RegulationArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegulationArticle {
  id           String     @id @default(cuid())
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  regulationId String
  articleCode  String // Article number/code
  title        String
  description  String     @db.Text
  category     String? // Yönetişim, Risk, Teknik, Erişim, Personel, Fiziksel, Denetim, Süreklilik, Genel

  // Mappings
  risks    RiskRegulation[]
  controls ControlRegulation[]

  // Cross-references to other articles
  crossRefsFrom ArticleCrossRef[] @relation("CrossRefSource")
  crossRefsTo   ArticleCrossRef[] @relation("CrossRefTarget")

  createdAt DateTime @default(now())

  @@unique([regulationId, articleCode])
  @@index([regulationId])
}

model ArticleCrossRef {
  id       String            @id @default(cuid())
  sourceId String
  source   RegulationArticle @relation("CrossRefSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   RegulationArticle @relation("CrossRefTarget", fields: [targetId], references: [id], onDelete: Cascade)
  note     String?

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model RiskRegulation {
  id        String            @id @default(cuid())
  risk      Risk              @relation(fields: [riskId], references: [id], onDelete: Cascade)
  riskId    String
  article   RegulationArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  @@unique([riskId, articleId])
  @@index([articleId])
}

model ControlRegulation {
  id        String            @id @default(cuid())
  control   Control           @relation(fields: [controlId], references: [id], onDelete: Cascade)
  controlId String
  article   RegulationArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  @@unique([controlId, articleId])
  @@index([articleId])
}

// ==========================================
// KURUMSAL KAYNAK KÜTÜPHANESİ
// AI Kontrol & Kanıt Değerlendirme'nin "grounding" katmanı: politika, prosedür,
// metodoloji, derecelendirme rehberi, terminoloji ve emsal kararlar. Mevzuat
// maddeleri gibi elle seçilip değerlendirme oturumuna snapshot'lanır.
// ==========================================

model KnowledgeDoc {
  id            String           @id @default(cuid())
  kind          KnowledgeDocKind
  code          String           @unique // ör. "POL-BT-01"
  title         String
  body          String           @db.Text
  category      String?
  tags          String[]
  sourceRef     String? // kaynak/atıf (doküman no, yayım bilgisi)
  effectiveDate DateTime?
  isActive      Boolean          @default(true)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kind])
  @@index([isActive])
}

enum KnowledgeDocKind {
  POLICY // Politika
  PROCEDURE // Prosedür / talimat
  METHODOLOGY // Test / denetim metodolojisi
  RUBRIC // Derecelendirme / puanlama rehberi
  GLOSSARY // Terminoloji
  PRECEDENT // Emsal karar / örnek bulgu (elle girilen)
}

// ==========================================
// KAYIT NUMARASI SAYAÇLARI
// İnsan-okur sıralı kayıt numaraları (A-2026-0007, T-2026-0012 …) için atomik
// sayaç. "max+1" / random yerine `UPDATE ... value = value + 1 RETURNING` — tek
// deyim, yarış-koşulu yok, retry gerektirmez, transaction içinde güvenli.
// ==========================================

model RecordCounter {
  scope     String   @id // "action" | "followup"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ==========================================
// AUDIT LOG (System-wide logging)
// ==========================================

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, APPROVAL
  entityType String // Risk, Control, Finding, Action, etc.
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// ==========================================
// PARAMETERS & CONFIGURATION
// ==========================================

model Parameter {
  id          String   @id @default(cuid())
  category    String // RISK_SCORING, SLA, GENERAL
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ==========================================
// SYSTEM OPTIONS (Dynamic Dropdowns)
// ==========================================

model SystemOption {
  id        String   @id @default(cuid())
  category  String // CONTROL_FREQUENCY, CONTROL_TYPE, CONTROL_NATURE, etc.
  value     String // DAILY, WEEKLY, IT_GENERAL, etc.
  label     String // Günlük, Haftalık, IT Genel, etc.
  labelEn   String? // English label (optional)
  color     String? // Badge color (optional)
  icon      String? // Icon name (optional)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false) // Default selection
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
  @@index([isActive])
}

// ==========================================
// RISK ENTRY AND CALCULATION (Excel-like Grid)
// ==========================================

enum RiskEntryRecordType {
  RISK
  OPPORTUNITY
  ISSUE
}

enum RiskEntryStatus {
  AKTIF
  PASIF
  KAPATILDI
  BEKLEMEDE
  ONAYLI
  TASLAK
}

enum RiskEntryLevel {
  KRITIK
  YUKSEK
  ORTA
  DUSUK
}

enum ControlEffectivenessLevel {
  ETKIN
  KISMEN_ETKIN
  ETKIN_DEGIL
}

enum RiskTreatmentOption {
  KABUL_ET
  AZALT
  TRANSFER_ET
  KACIN
}

model RiskEntry {
  id String @id @default(cuid())

  // Group 1: Kimlik (Identity)
  riskId     String              @unique // Auto: R-YYYY-NNNN
  kayitId    String              @unique // Unique record identifier
  kayitTipi  RiskEntryRecordType @default(RISK)
  riskStatus RiskEntryStatus     @default(AKTIF)

  // Group 2: Organizasyon (Organization)
  riskSahibi String? // User reference (text for now, LDAP later)
  surec      String? // Process name
  altSurec   String? // Sub-process name
  riskTanimi String  @db.Text // Risk definition (multi-line)

  // Group 3: IT Flag
  flagForIT Boolean @default(false)

  // Group 4: Etki Boyutları (Impact Dimensions) - All 1-5 scale
  finansalEtki        Int? @default(1) // (%30)
  itibarEtkisi        Int? @default(1) // (%30)
  regulasyonEtkisi    Int? @default(1) // (%20)
  musteriEtkisi       Int? @default(1) // (%20)
  gizlilikEtkisi      Int? @default(1) // (%35) - CIA
  butunlukEtkisi      Int? @default(1) // (%30) - CIA
  erisebilirlikEtkisi Int? @default(1) // (%35) - CIA

  // Group 5: Doğal Risk Skorlama (Inherent Risk Scoring)
  etki              Float? // CALCULATED: Weighted average of impacts
  olasilik          Int?            @default(1) // 1-5 scale, user input
  dogalRiskPuani    Float? // CALCULATED: Etki × Olasılık
  dogalRiskSkoru    Int? // CALCULATED: Normalized 0-100
  dogalRiskSeviyesi RiskEntryLevel? // CALCULATED: Threshold-based

  // Group 6: Kontrol Değerlendirmesi (Control Assessment)
  butunlesikKontrolPuani    Float? // User input or from controls
  butunlesikKontrolSkoru    Int? // CALCULATED
  butunlesikKontrolSeviyesi ControlEffectivenessLevel? // CALCULATED

  // Group 7: Kalıntı Risk (Residual Risk)
  kalintiRiskPuani    Float? // CALCULATED
  kalintiRiskSkoru    Int? // CALCULATED
  kalintiRiskSeviyesi RiskEntryLevel? // CALCULATED

  // Group 8: İşleme & Tarihler (Treatment & Dates)
  riskIsleme       RiskTreatmentOption?
  mutabakatTarihi  DateTime?
  olusturmaTarihi  DateTime             @default(now()) // SYSTEM
  guncellemeTarihi DateTime             @updatedAt // SYSTEM

  // Group 9: Sorumluluk (Responsibility)
  riskSorumlusu String? // User reference
  atanan        String? // User reference
  olusturan     String? // SYSTEM: Current user
  kaydiAcan     String? // SYSTEM: Current user

  // Audit & Version
  version Int @default(1)

  // Relation to main Risk table (optional sync)
  syncedRisk   Risk?   @relation(fields: [syncedRiskId], references: [id])
  syncedRiskId String?

  // Relation to Risk Management Controls (RYK)
  riskManagementControls RiskEntryRMControl[]

  @@index([riskStatus])
  @@index([dogalRiskSeviyesi])
  @@index([kalintiRiskSeviyesi])
  @@index([surec])
  @@index([olusturmaTarihi])
}

// ==========================================
// RISK MANAGEMENT CONTROLS (RYK)
// Risk Yönetimi Ekibinin Kontrolleri
// ==========================================

// Risk Management Control (RYK) - Risk Yönetimi Ekibinin Kontrolleri
model RiskManagementControl {
  id          String @id @default(cuid())
  controlCode String @unique // RYK-001, RYK-002...
  name        String
  description String @db.Text

  // Kontrol Parametreleri (1-5 arası)
  effectiveness   Int @default(3) // Etkinlik (%50)
  frequency       Int @default(3) // Sıklık (%30)
  automationLevel Int @default(3) // Otomasyon (%20)

  // Hesaplanan Skorlar
  controlScore Float? // Bireysel kontrol skoru

  // Owner
  ownerId String?

  // Status
  isActive Boolean @default(true)

  // Relations
  riskMappings RiskEntryRMControl[]
  tests        RMControlTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([controlCode])
  @@index([isActive])
}

// Risk-RYK Kontrol Eşleştirmesi
model RiskEntryRMControl {
  id          String                @id @default(cuid())
  riskEntry   RiskEntry             @relation(fields: [riskEntryId], references: [id], onDelete: Cascade)
  riskEntryId String
  control     RiskManagementControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  controlId   String

  // Bu kontrol için risk-spesifik etkinlik değerlendirmesi
  applicabilityScore Int @default(3) // 1-5, bu risk için kontrol ne kadar geçerli

  createdAt DateTime @default(now())

  @@unique([riskEntryId, controlId])
  @@index([riskEntryId])
  @@index([controlId])
}

// RYK Test Geçmişi
model RMControlTest {
  id        String                @id @default(cuid())
  control   RiskManagementControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  controlId String
  testDate  DateTime
  tester    String
  result    TestResult
  notes     String?               @db.Text

  createdAt DateTime @default(now())

  @@index([controlId])
  @@index([testDate])
}

// ==========================================
// RİSK YÖNETİMİ — KONTROL ALANI
// Risk'e özgü kontroller (Kontrol Envanteri'ndeki IKS kontrollerinden farklı)
// ==========================================

enum RiskControlStatus {
  TASLAK
  AKTIF
  PASIF
}

enum RiskActionStatus {
  ACIK
  DEVAM_EDIYOR
  TAMAMLANDI
  GECIKTI
  IPTAL
}

model RiskControl {
  id        String  @id @default(cuid())
  kontrolId String  @unique // RC-YYYY-XXXX
  kayitId   String? // Jira kayıt ID

  status RiskControlStatus @default(AKTIF)

  // Risk bağlamı (denormalized — RCA mapping görünümü için)
  ilgiliGmy  String?
  riskSahibi String?
  surec      String?
  altSurec   String?
  riskTanimi String? @db.Text

  // Kontrol içeriği
  kontrolTanimi           String  @db.Text
  kontrolTuru             String? // Önleyici / Düzeltici / Tespit Edici
  kontrolIslevi           String? // Manuel / Otomatik / Yarı Otomatik
  kontrolIsletimeSekli    String?
  kontrolIsletimDenetimi  String?
  kontrolIsletimRaporlama String?
  birSeviyeKontrolSikligi String? // Günlük / Haftalık / Aylık / vb.

  // Puanlama
  kontrolPuani              Float?
  kontrolSkoru              String? // 1-25
  butunlesikKontrolPuani    Float?
  butunlesikKontrolSkoru    String?
  butunlesikKontrolSeviyesi String? // DÜŞÜK / ORTA / YÜKSEK

  // Org
  riskSorumlusu   String?
  ozet            String?   @db.Text
  mutabakatTarihi DateTime?

  // İlişkiler
  risks   RiskControlRisk[]
  actions RiskAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Risk ↔ RiskControl many-to-many
model RiskControlRisk {
  id            String      @id @default(cuid())
  risk          Risk        @relation(fields: [riskId], references: [id], onDelete: Cascade)
  riskId        String
  riskControl   RiskControl @relation(fields: [riskControlId], references: [id], onDelete: Cascade)
  riskControlId String

  @@unique([riskId, riskControlId])
  @@index([riskId])
  @@index([riskControlId])
}

// ==========================================
// RİSK YÖNETİMİ — AKSİYON TABLOSU
// Risk'e özgü aksiyonlar (IKS CorrectiveAction'larından farklı)
// ==========================================

model RiskAction {
  id        String  @id @default(cuid())
  aksiyonId String  @unique // RA-YYYY-XXXX
  kayitId   String? // Jira kayıt ID

  status RiskActionStatus @default(ACIK)

  aksiyonTanimi    String  @db.Text
  aksiyonSahibi    String?
  aksiyonSorumlusu String?
  atanan           String?
  ilgiliGmy        String?
  ozet             String? @db.Text
  potaNo           String?
  bulgReferansNo   String?

  mutabakatTarihi            DateTime?
  hedeflenenTamamlanmaTarihi DateTime?
  tamamlanmaTarihi           DateTime?

  // Kontrol ile ilişki
  riskControl   RiskControl? @relation(fields: [riskControlId], references: [id])
  riskControlId String?

  // Risk ↔ RiskAction many-to-many
  risks RiskActionRisk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Risk ↔ RiskAction many-to-many
model RiskActionRisk {
  id           String     @id @default(cuid())
  risk         Risk       @relation(fields: [riskId], references: [id], onDelete: Cascade)
  riskId       String
  riskAction   RiskAction @relation(fields: [riskActionId], references: [id], onDelete: Cascade)
  riskActionId String

  @@unique([riskId, riskActionId])
  @@index([riskId])
  @@index([riskActionId])
}

// ==========================================
// AI — YAPAY ZEKA DESTEKLİ MODÜLLER
// ==========================================

/// Bir AI aşama çıktısının kalıcı kaydı. Polimorfik bağ (entityType + entityId),
/// tıpkı Attachment gibi — mevcut modellere kolon eklenmez. AI hiçbir kaydı
/// doğrudan değiştirmez: çıktı burada "öneri" olarak durur, kullanıcı
/// Kabul / Düzenle / Reddet yapar, kabul edilen içerik ilgili servisle yazılır.
model AiAssessment {
  id         String             @id @default(cuid())
  kind       AiAssessmentKind
  entityType String // "ControlTest" | "Finding"
  entityId   String
  status     AiAssessmentStatus @default(PROCESSING)

  // Model çağrısı meta
  tier          String // "heavy" | "light" | "vision"
  modelName     String
  promptVersion String
  inputHash     String // aynı girdi → önbellek anahtarı
  tokensIn      Int?
  tokensOut     Int?
  latencyMs     Int?
  errorText     String? @db.Text

  // Çıktı
  output     Json? // yapılandırılmış sonuç (plan / skorkart / taslak)
  confidence Float?

  // Kullanıcı kararı
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  editedOutput Json? // kullanıcı "Düzenle" ile değiştirdiyse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([kind])
  @@index([status])
  @@index([inputHash])
  @@index([createdById])
}

enum AiAssessmentKind {
  PREP_PLAN // Aşama 0 — test hazırlık planı
  EVIDENCE_READ // Aşama 1 — kanıt okuma / OCR / sınıflandırma
  ASSESSMENT // Aşama 2 — test adımı × kanıt skorkartı
  RESULT_DRAFT // Aşama 3 — sonuç + kanıt özeti taslağı
  FINDING_DRAFT // Aşama 4 — bulgu + öneri taslağı
  REVIEW // Faz 3 — 2. kontrolcü inceleme ön-raporu
}

enum AiAssessmentStatus {
  PROCESSING // kuyrukta / model çağrısı sürüyor
  SUGGESTED // çıktı hazır, kullanıcı kararı bekliyor
  ACCEPTED // kullanıcı kabul etti (ilgili alana yazıldı)
  EDITED // kullanıcı düzenleyip kabul etti
  REJECTED // kullanıcı reddetti
  FAILED // model çağrısı hata verdi
}

// ==========================================
// AI — KONTROL & KANIT DEĞERLENDİRME
// Kayıttan bağımsız, sohbet tabanlı uyum değerlendirmesi.
// Kontrol Alanı (envanterden veya elle) + Mevzuat + Yanıt/Kanıt Alanı → AI uyum çıktısı.
// ==========================================

model AiEvalSession {
  id    String @id @default(cuid())
  title String

  // Kontrol Alanı
  controlRefId         String? // Kontrol Envanteri'nden seçildiyse Control.id
  controlText          String?  @db.Text // elle yazıldıysa
  controlManualNote    String?  @db.Text // envanter seçiminde bile eklenebilen serbest not
  controlSnapshot      Json? // seçilen kontrolün o anki kopyası (isim/tanım/testSteps)
  regulationArticleIds String[] // seçilen RegulationArticle.id listesi
  regulationSnapshot   Json? // maddelerin kopyası
  knowledgeDocIds      String[] // seçilen KnowledgeDoc.id listesi
  knowledgeSnapshot    Json? // kurumsal kaynakların kopyası

  // Kaynak Kataloğu (SourceUnit) — sürümlü, yetkilendirilmiş kaynaklardan seçim.
  // "Önerilen / kullanıcı onaylı / gerçekte kullanılan" ayrımı için 3 ayrı alan.
  suggestedSourceUnitIds String[] // RAG'in önerdiği birimler
  sourceUnitIds          String[] // kullanıcının seçtiği/onayladığı birimler
  usedSourceUnitIds      String[] // değerlendirmede GERÇEKTEN retrieval'a giren birimler
  sourceSnapshot         Json? // seçilen birimlerin (sürüm+metin) kopyası

  // Yanıt/Kanıt Alanı — kalıcı serbest metin (dosyalara ek olarak)
  evidenceText String? @db.Text

  // Dönem (ör. "Eylül 2026" / "2026 Q3") — başlık ve çoğaltmada kullanılır.
  period String?

  createdById String
  // Yaşam döngüsü — İŞLEM DURUMUNDAN ayrı (arşiv/çöp kutusu).
  status      AiEvalStatus @default(ACTIVE)
  trashedAt   DateTime?

  // İŞLEM DURUMU — AI çalışmasının kendisi. AI yanıtı tek başına "tamamlandı"
  // yapmaz: başarılı çalışma AWAITING_REVIEW, kullanıcı sonuçlandırınca COMPLETED.
  runStatus       AiEvalRunStatus @default(DRAFT)
  runStartedAt    DateTime?
  runProgress     Json? // { phase, filesRead, filesTotal } — GERÇEK sayılar, sahte % yok
  cancelRequested Boolean         @default(false)
  // DEĞERLENDİRME SONUCU — incelenmiş sonuçtan (kullanıcı sonuçlandırır).
  outcome         AiEvalOutcome?
  completedAt     DateTime?
  completedById   String?

  // Kullanıcı başlığı elle değiştirdiyse otomatik başlık ONU EZMEZ.
  titleEditedByUser Boolean @default(false)

  // Optimistic concurrency — autosave yarışı / çok sekme çatışması.
  contentVersion Int     @default(0)
  // Girdiler (kontrol/kapsam/kanıt) son değerlendirmeden sonra değişti mi?
  inputsDirty    Boolean @default(false)

  // Son değerlendirme çıktısı şema doğrulaması / atıf doğrulaması sonrasında
  // insan incelemesi gerektiriyor mu? (uydurma atıf, şema ihlali, çelişki vb.)
  needsReview       Boolean @default(false)
  needsReviewReason String? @db.Text

  // "Yeni dönem için çoğalt" soyağacı.
  clonedFrom   AiEvalSession?  @relation("AiEvalClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clonedFromId String?
  clones       AiEvalSession[] @relation("AiEvalClone")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    AiEvalMessage[]
  attachments AiEvalAttachment[]

  @@index([createdById])
  @@index([controlRefId])
  @@index([status])
  @@index([runStatus])
  @@index([createdById, status, updatedAt])
}

model AiEvalMessage {
  id        String            @id @default(cuid())
  session   AiEvalSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      AiEvalRole
  // Mesaj türü: tam değerlendirme koşusu / kullanıcı ek sorusu / ek soruya yanıt.
  // QUESTION+ANSWER, 6 başlıklı raporu YENİDEN ÜRETMEZ (bkz. AiEvalService.askQuestion).
  kind      AiEvalMessageKind @default(EVALUATION)
  content   String            @db.Text // kullanıcı mesajı ham metni veya asistan sohbet notu

  // Bu koşuya kanıttan AYRI olarak dahil edilen kullanıcı ek açıklaması (snapshot).
  additionalNote String? @db.Text
  // ANSWER mesajları için düz metin yanıt (evaluation JSON'u yok).
  answerText     String? @db.Text

  // Sürümlü yapılandırılmış çıktı şeması + runtime doğrulama sonucu.
  schemaVersion    String?
  schemaValid      Boolean?
  schemaIssues     Json? // [{ path, message }] — şema/atıf doğrulama bulguları
  // Otomatik + elle kaynak getirme özeti: { autoSuggested, sent, indexState, notes[] }.
  retrievalNote    Json?
  // AI'nin ÖZGÜN çıktısı — kullanıcı düzenlemesi bunu EZMEZ.
  evaluation       Json? // { uyumluAlanlar[], uyumsuzAlanlar[], genelDurum, bulguAdaylari[], eksikBilgi[] }
  // Kullanıcının düzenleyip kabul ettiği sürüm + tespit bazında inceleme kararları
  // (_review: { status: ACCEPTED|EDITED|REJECTED, reviewerId, reviewedAt, reason }).
  editedEvaluation Json?
  reviewedById     String?
  reviewedAt       DateTime?

  modelName     String?
  promptVersion String?
  // Bu çalışmanın dayandığı girdi sürümü (session.contentVersion) ve kullanılan kanıtlar.
  inputVersion  Int?
  evidenceRefs  Json? // { attachmentIds: string[], evidenceTextHash: string, knowledgeDocIds, regulationArticleIds }

  // ÇALIŞMA SEVİYESİ SNAPSHOT — bu koşuya giren TÜM girdileri yeniden kurabilmek
  // için (oturum seviyesi yetmez). { contentVersion, controlTextHash, evidenceTextHash,
  // attachmentHashes[], sourceUnits: [{unitId, versionId, sourceSlug, versionLabel, textHash, truncated}] }
  runInputSnapshot  Json?
  // Bu koşuda modele GERÇEKTEN iletilen kaynak birimleri (seçili ∩ geçerli ∩ sınır içi).
  sentSourceUnitIds String[]
  // Çıktıda GEÇERLİ ATIF yapılan kaynaklar — her biri gerçek unit/version + konum +
  // (alıntı varsa) özgün metinle doğrulanır; ilişki insan incelemesine sunulur.
  // [{ sourceUnitId, sourceVersionId, unitCode, group, index, quote?, textVerified, relationReviewed, reviewerNote }]
  citedSourceRefs   Json?

  tokensIn  Int?
  tokensOut Int?
  latencyMs Int?
  errorText String? @db.Text

  // İptal edilen / eski girdi sürümüne ait geç gelen sonuç — güncel sonucu EZMEZ.
  cancelled Boolean @default(false)
  stale     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

model AiEvalAttachment {
  id            String               @id @default(cuid())
  session       AiEvalSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String
  fileName      String // uploads göreli yolu (YYYY/MM/hex.ext)
  originalName  String
  mimeType      String
  sizeBytes     Int
  kind          AiEvalAttachmentKind
  extractedText String?              @db.Text // çıkarılan metin (önbellek)
  uploadedById  String?

  // Kullanıcının belirttiği belge meta bilgisi (item 7).
  docDate         String? // belgedeki tarih/dönem (serbest metin)
  relatedSystem   String? // ilgili sistem
  relatedSample   String? // örneklem
  relatedTestStep String? // ilgili test adımı
  note            String? @db.Text

  // Okuma durumu — GERÇEK backend sonucundan üretilir.
  readStatus AiEvalReadStatus @default(PENDING)
  readNote   String?          @db.Text

  // Sürüm zinciri — "yeni sürüm yükle" eskisini YERİNDE değiştirmez.
  version        Int               @default(1)
  active         Boolean           @default(true) // yalnızca aktif sürüm değerlendirmede kullanılır
  supersededBy   AiEvalAttachment? @relation("AttVersion", fields: [supersededById], references: [id], onDelete: SetNull)
  supersededById String?           @unique
  supersedes     AiEvalAttachment? @relation("AttVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([sessionId, active])
}

enum AiEvalReadStatus {
  PENDING // Bekliyor
  READING // Okunuyor
  READ // Okundu
  PARTIAL // Kısmen okundu
  FAILED // Okunamadı
}

enum AiEvalStatus {
  ACTIVE
  ARCHIVED
  TRASHED
}

// İŞLEM DURUMU — AI çalışmasının durumu (yaşam döngüsünden ayrı).
enum AiEvalRunStatus {
  DRAFT // Taslak — henüz değerlendirilmedi
  RUNNING // Değerlendiriliyor — AI çağrısı sürüyor
  AWAITING_REVIEW // İnceleme bekliyor — AI çalışması başarılı, kullanıcı sonuçlandırmalı
  COMPLETED // Tamamlandı — kullanıcı sonuçlandırdı
  ERROR // Hata — AI çağrısı başarısız
}

// DEĞERLENDİRME SONUCU — incelenmiş sonuçtan kullanıcı belirler.
enum AiEvalOutcome {
  MET // Karşılandı
  PARTIALLY_MET // Kısmen karşılandı
  NOT_MET // Karşılanmadı
  INCONCLUSIVE // Değerlendirilemedi
}

enum AiEvalRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiEvalMessageKind {
  EVALUATION // tam 6 başlıklı değerlendirme koşusu
  QUESTION // kullanıcının ek sorusu / açıklaması
  ANSWER // ek soruya doğrudan yanıt (raporu yeniden üretmez)
}

enum AiEvalAttachmentKind {
  DOCUMENT
  IMAGE
  EMAIL
  TEXT
}

// ==========================================
// KAYNAK KATALOĞU — GENİŞLETİLMİŞ KÜTÜPHANE
// kaynak → sürüm → birim (madde/kontrol) → eşleştirme → test kartı →
// kanıt yeterliliği → değerlendirme veri setleri → kalite ölçümü.
// KnowledgeDoc (mevcut) korunur; bu modeller onun yanında zenginleştirilmiş
// katmanı sağlar. Özgün metin / çeviri / yorum / kurum içi metodoloji AYRI alanlarda.
// ==========================================

enum SourceKind {
  REGULATION // Mevzuat
  STANDARD_FRAMEWORK // Standart / çerçeve
  AUDIT_METHODOLOGY // Denetim metodolojisi
  CORPORATE_POLICY // Kurumsal politika / prosedür
  PRODUCT_DOC // Teknik ürün dokümantasyonu
  CONTROL_TEST_CARD // Kontrol test kartı
  EVIDENCE_GUIDE // Kanıt değerlendirme rehberi
  PRECEDENT_FINDING // Emsal bulgu
  TRAINING_EXAMPLE // Eğitim örneği
  EVAL_SCENARIO // Değerlendirme/test senaryosu
}

enum SourceConfidentiality {
  PUBLIC
  INTERNAL
  RESTRICTED
  CONFIDENTIAL
}

enum SourceApprovalStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  WITHDRAWN
}

// "Bilinmeyen hakkı 'izinli' kabul etme" — UNKNOWN, ALLOWED değildir.
enum UsagePermission {
  UNKNOWN
  ALLOWED
  DENIED
}

model Source {
  id              String                @id @default(cuid())
  kind            SourceKind
  slug            String                @unique // kalıcı kısa kimlik: "nist-sp-800-53-r5"
  title           String
  publisher       String?
  officialUrl     String? // resmî adres
  docCode         String? // doküman kodu
  language        String                @default("en")
  owner           String? // sahibi (kurum içi sorumlu)
  confidentiality SourceConfidentiality @default(PUBLIC)
  tags            String[]

  // Kullanım hakları — AYRI alanlar. Varsayılan UNKNOWN (izinli değil).
  rightRefLink  UsagePermission @default(UNKNOWN) // referans/link saklanabilir mi
  rightFullText UsagePermission @default(UNKNOWN) // tam metin saklanabilir mi
  rightRag      UsagePermission @default(UNKNOWN) // RAG'de kullanılabilir mi
  rightFineTune UsagePermission @default(UNKNOWN) // fine-tuning için kullanılabilir mi
  rightExport   UsagePermission @default(UNKNOWN) // dışa aktarılabilir mi
  rightsNote    String?         @db.Text

  // KULLANIM HAKKI ONAYI — içerik onayından AYRI. Dayanak + onaylayan saklanır.
  // Sistem bunu kendiliğinden ALLOWED yapmaz; yalnız yetkili kullanıcı işaretler.
  rightsVerifiedById String?
  rightsVerifiedAt   DateTime?
  rightsBasis        String?   @db.Text // hangi lisans/yazışma/karar; kim onayladı

  // İzole test verisi işareti — fixture'lar üretimde görünmesin diye ayrılır.
  isTestFixture Boolean @default(false)

  createdById  String
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions SourceVersion[]

  @@index([kind])
  @@index([confidentiality])
  @@index([isTestFixture])
}

model SourceVersion {
  id               String               @id @default(cuid())
  source           Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId         String
  versionLabel     String // "Rev.5", "2.0", "2025.09"
  publishDate      DateTime?
  effectiveDate    DateTime?
  validUntil       DateTime? // geçerlilik sonu (yayından kalkma)
  accessedAt       DateTime? // erişim tarihi
  contentHash      String? // içerik hash'i (SHA-256, ilk 32)
  contentRetrieved Boolean              @default(false) // tam metin gerçekten alındı mı
  fullText         String?              @db.Text // ÖZGÜN tam metin (hak varsa)
  storageNote      String?              @db.Text // neden alınmadı / kısıt açıklaması
  approvalStatus   SourceApprovalStatus @default(DRAFT)

  // İÇERİK İNCELEMESİ — kullanım hakkından AYRI. Metin/birimlerin doğru,
  // eksiksiz ve kullanılabilir olduğunun teyidi.
  contentReviewedById String?
  contentReviewedAt   DateTime?

  // RAG İNDEKS DURUMU — "hazır" yalnız READY iken. Job geçmişi SourceIndexJob'da.
  indexStatus      SourceIndexStatus @default(NONE)
  indexedAt        DateTime?
  indexChunkCount  Int               @default(0)
  indexError       String?           @db.Text
  indexAttempts    Int               @default(0)
  // İçerik değişince indeks eskir (STALE) — sessizce "hazır" gösterilmez.
  contentChangedAt DateTime?

  // Yeni sürüm eskisini EZMEZ; yerine geçme ilişkisi.
  supersededBy   SourceVersion? @relation("VersionSupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersededById String?        @unique
  supersedes     SourceVersion? @relation("VersionSupersede")

  units               SourceUnit[]
  chunks              SourceChunk[]
  mappings            SourceMapping[]
  evalScenarioSources EvalScenarioSource[]
  indexJobs           SourceIndexJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceId, versionLabel])
  @@index([sourceId])
  @@index([approvalStatus])
}

enum SourceIndexStatus {
  NONE // hiç indekslenmedi
  QUEUED // iş oluşturuldu
  RUNNING
  READY // güncel indeks var
  ERROR
  STALE // içerik değişti, yeniden indeksleme gerekli
}

// RAG indeksleme işi — başarı/hata/yeniden deneme görünürlüğü için geçmiş kaydı.
// Modül senkron çalışır (mevcut sağlayıcı, yeni altyapı yok): iş RUNNING→READY/ERROR
// aynı istekte tamamlanır; ERROR'da "Yeniden dene" yeni bir iş açar.
model SourceIndexJob {
  id          String            @id @default(cuid())
  version     SourceVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId   String
  status      SourceIndexStatus @default(QUEUED)
  attempt     Int               @default(1)
  chunkCount  Int?
  error       String?           @db.Text
  createdById String
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?

  @@index([versionId])
  @@index([status])
}

model SourceUnit {
  id            String        @id @default(cuid())
  version       SourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId     String
  stableKey     String // kalıcı birim ID (sürümler arası izlenebilir): "AC-2", "md.3.1.1.2"
  unitCode      String // görüntülenen madde/kontrol kodu
  unitType      String        @default("clause") // "article" | "clause" | "control" | "section"
  title         String
  originalText  String        @db.Text // ÖZGÜN metin (birebir alıntı)
  translationTr String?       @db.Text // Türkçe açıklama/çeviri — AYRI
  commentaryTr  String?       @db.Text // kurum içi yorum — AYRI
  locator       Json? // { page, section, sheet, cellRange, heading }
  scope         String?
  riskAreas     String[]
  parentKey     String? // fıkra/bent hiyerarşisi

  mappings         SourceMapping[]
  chunks           SourceChunk[]
  evalScenarioRefs EvalScenarioRef[]

  createdAt DateTime @default(now())

  @@unique([versionId, stableKey])
  @@index([versionId])
  @@index([stableKey])
}

// tam karşılar / kısmen karşılar / destekler / ilişkili
enum MappingMatchType {
  FULL
  PARTIAL
  SUPPORTS
  RELATED
}

enum MappingStatus {
  PENDING // eşleştirme bekliyor
  AI_DRAFT // AI önerisi (taslak)
  USER_CONFIRMED // kullanıcı onayladı — resmî uyum haritasına girer
  REJECTED
}

enum MappingTargetType {
  CONTROL
  CONTROL_TEST_CARD
  PROCESS_SCOPE_CARD
  RISK
}

model SourceMapping {
  id            String            @id @default(cuid())
  targetType    MappingTargetType
  controlId     String?
  control       Control?          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  testCardId    String?
  testCard      ControlTestCard?  @relation(fields: [testCardId], references: [id], onDelete: Cascade)
  processCardId String?
  processCard   ProcessScopeCard? @relation(fields: [processCardId], references: [id], onDelete: Cascade)

  version   SourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId String
  unit      SourceUnit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId    String?

  matchType              MappingMatchType
  status                 MappingStatus    @default(PENDING)
  rationale              String?          @db.Text
  bindingType            String? // "binding_obligation" | "good_practice"
  applicabilityRationale String?          @db.Text
  approvedById           String?
  approvedAt             DateTime?
  createdById            String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([controlId])
  @@index([testCardId])
  @@index([processCardId])
  @@index([versionId])
  @@index([status])
}

enum TestCardOrigin {
  AI_DRAFT
  INTERNAL_METHODOLOGY
  IMPORTED
}

enum TestCardStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  WITHDRAWN
}

model ControlTestCard {
  id      String         @id @default(cuid())
  code    String         @unique // "TK-BT-01"
  topicNo Int? // 1..12 (başlangıç konuları)
  title   String
  origin  TestCardOrigin @default(AI_DRAFT)
  status  TestCardStatus @default(DRAFT)
  version Int            @default(1)

  purposeRisk           String @db.Text // amaç ve risk
  scopePrereq           String @db.Text // kapsam / önkoşullar
  method                String @db.Text // inceleme / görüşme / test yöntemi
  steps                 Json // [{ no: number, text: string }]
  expectedState         String @db.Text // beklenen durum
  requestedEvidence     Json // string[]
  evidenceSufficiency   String @db.Text // kanıt yeterlilik koşulları
  decisionCriteria      Json // { met, notMet, inconclusive, conflicting }
  misleadingSignals     String @db.Text // yanlış sonuca götürebilecek durumlar
  sampleControlResult   String @db.Text // kısa kontrol sonucu örneği
  sampleEvidenceRequest String @db.Text // eksik kanıt talebi örneği

  relatedControlId String?
  relatedControl   Control? @relation(fields: [relatedControlId], references: [id], onDelete: SetNull)

  mappings  SourceMapping[]
  scenarios EvalScenario[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([topicNo])
}

model ProcessScopeCard {
  id               String         @id @default(cuid())
  code             String         @unique // "SK-ISLEM-01"
  title            String
  area             String // "trading" | "market_data" | "surveillance" | "connectivity" | "session" | "clock_records"
  status           TestCardStatus @default(DRAFT)
  description      String         @db.Text
  criticalAssets   Json // string[]
  // RTO/RPO/gecikme toleransı/saklama süresi/işlem limiti — KURUM DOLDURACAK parametreler.
  paramSpec        Json // [{ key, label, unit, filledValue: null }]
  linkedControlIds String[] // ilgili genel BT kontrolleri (Control.id)

  mappings SourceMapping[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EvidenceSufficiencyRule {
  id          String         @id @default(cuid())
  code        String         @unique // "KY-01"
  category    String // "distinction" (ayrım) | "dimension" (boyut)
  title       String
  rule        String         @db.Text
  goodExample String?        @db.Text
  badExample  String?        @db.Text
  scoringSpec Json? // boyut ağırlıkları / hesap yöntemi (sayısal puan verilecekse)
  status      TestCardStatus @default(DRAFT)
  orderNo     Int            @default(0)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SourceChunk {
  id         String        @id @default(cuid())
  version    SourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId  String
  unit       SourceUnit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId     String?
  ordinal    Int
  text       String        @db.Text
  embedding  Float[] // double precision[] — pgvector yok; bellek-içi kosinüs (mevcut desen)
  embedModel String?
  tokenCount Int?
  createdAt  DateTime      @default(now())

  @@index([versionId])
  @@index([unitId])
}

enum EvalDatasetPurpose {
  RAG_SOURCE // A. RAG kaynakları
  TRAINING_EXAMPLE // B. Uzman onaylı eğitim örnekleri
  EVAL_HOLDOUT // C. Eğitimde kullanılmayan değerlendirme seti
}

model EvalDataset {
  id          String             @id @default(cuid())
  code        String             @unique // "DS-A-RAG" | "DS-B-TRAIN" | "DS-C-EVAL"
  name        String
  purpose     EvalDatasetPurpose
  description String?            @db.Text

  scenarios EvalScenario[]

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ScenarioKind {
  SUFFICIENT_EVIDENCE // yeterli kanıt
  CONTROL_GAP // açık kontrol eksikliği
  INSUFFICIENT_EVIDENCE // yetersiz kanıt
  CONFLICTING_EVIDENCE // çelişkili kanıt
  WRONG_PERIOD_SCOPE // yanlış dönem/kapsam
}

enum ScenarioStatus {
  SYNTHETIC_PENDING_REVIEW // sentetik ve uzman onayı bekliyor
  EXPERT_APPROVED
  REJECTED
}

model EvalScenario {
  id         String           @id @default(cuid())
  scenarioId String           @unique // "SEN-TK01-A"
  familyKey  String // veri sızıntısı önleme — aynı aile train/test'e BÖLÜNMEZ
  dataset    EvalDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId  String
  testCard   ControlTestCard? @relation(fields: [testCardId], references: [id], onDelete: SetNull)
  testCardId String?

  kind      ScenarioKind
  status    ScenarioStatus @default(SYNTHETIC_PENDING_REVIEW)
  synthetic Boolean        @default(true)

  inputEvidence       Json // [{ name, type, text }]
  expectedDecision    String // "KARSILANDI" | "KARSILANMADI" | "DOGRULANAMADI" | "CELISKILI"
  rationale           String @db.Text // kısa kanıtlı gerekçe
  requiredRefs        Json // string[] — gerekli referanslar
  forbiddenInferences Json // string[] — yasak çıkarımlar
  missingEvidence     Json // string[]

  labeledById  String?
  approvedById String?

  sourceRefs  EvalScenarioRef[]
  versionRefs EvalScenarioSource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([datasetId])
  @@index([familyKey])
  @@index([status])
  @@index([testCardId])
}

model EvalScenarioRef {
  id         String       @id @default(cuid())
  scenario   EvalScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String
  unit       SourceUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId     String

  @@unique([scenarioId, unitId])
  @@index([unitId])
}

model EvalScenarioSource {
  id         String        @id @default(cuid())
  scenario   EvalScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String
  version    SourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId  String

  @@unique([scenarioId, versionId])
  @@index([versionId])
}

enum QualityRunStatus {
  RUNNING
  DONE
  ERROR
}

model QualityRun {
  id               String           @id @default(cuid())
  label            String
  datasetId        String
  modelName        String?
  promptVersion    String?
  retrievalVersion String?
  status           QualityRunStatus @default(RUNNING)
  metrics          Json? // { correctRate, falseMet, badRefs, skippedSteps, missedGaps, conflictDetect, humanFixNeeded, latencyMsAvg, costUsd }
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  createdById      String

  items QualityRunItem[]

  @@index([datasetId])
  @@index([status])
}

model QualityRunItem {
  id                String     @id @default(cuid())
  run               QualityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId             String
  scenarioId        String
  predictedDecision String?
  expectedDecision  String?
  correct           Boolean?
  usedRefs          Json? // string[]
  issues            Json? // string[]
  latencyMs         Int?
  rawOutput         Json?
  createdAt         DateTime   @default(now())

  @@index([runId])
}

// ==========================================
// RİSK SİMÜLASYONU (SIM_METHODOLOGY_V1) — gerçek envanterden tamamen izole
// karar-destek çalışma alanı. Bu modeller Risk/Control/ControlTest/Action'a
// hiçbir alan eklemez; snapshot verisi burada, ayrı tutulur. Gerçek envantere
// yazma yalnızca RiskSimulationTransfer üzerinden, açık onaylı aktarım ile olur.
// ==========================================

model SimulationMethodology {
  id         String  @id @default(cuid())
  version    Int     @unique
  // calculation-engine.ts::MethodologyConfig serileştirilmiş hali. Her senaryo
  // oluşturulduğu andaki sürüme sabitlenir — config değişse bile eski senaryolar
  // sessizce yeniden hesaplanmaz.
  config     Json
  isActive   Boolean @default(false)
  changeNote String? @db.Text

  createdBy   User   @relation("SimMethodologyCreatedBy", fields: [createdById], references: [id])
  createdById String

  scenarios RiskSimulationScenario[]

  createdAt DateTime @default(now())

  @@index([isActive])
}

enum RiskSimulationStatus {
  ACTIVE
  ARCHIVED
}

model RiskSimulation {
  id           String               @id @default(cuid())
  simulationId String               @unique // SIM-YYYY-XXXX
  name         String
  description  String?              @db.Text
  status       RiskSimulationStatus @default(ACTIVE)

  createdBy   User   @relation("RiskSimulationCreatedBy", fields: [createdById], references: [id])
  createdById String

  scenarios RiskSimulationScenario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdById])
}

enum ScenarioSourceType {
  EXISTING_RISK
  HYPOTHETICAL
}

enum SimFinalImpactChoice {
  BUSINESS
  INFOSEC
}

model RiskSimulationScenario {
  id           String         @id @default(cuid())
  simulation   RiskSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  simulationId String
  name         String

  methodology          SimulationMethodology @relation(fields: [methodologyVersionId], references: [id])
  methodologyVersionId String

  // İyimser eşzamanlılık — ControlTest.contentVersion deseni.
  contentVersion Int @default(0)

  // Kaynak: gerçek bir riskten mi başladı, yoksa tamamen hipotetik mi.
  // EXISTING_RISK ise sourceRiskId + sourceRiskSnapshot + sourceCaptured* doldurulur.
  // sourceRiskId kasıtlı olarak FK DEĞİL (snapshot, sonraki envanter değişiklerinden
  // bağımsız kalmalı) — servis katmanında ayrıca doğrulanır/referanslanır.
  sourceType            ScenarioSourceType
  sourceRiskId          String?
  sourceRiskSnapshot    Json?
  sourceCapturedVersion Int?
  sourceCapturedAt      DateTime?

  // Senaryo oluşturulduğu andaki TAM başlangıç durumu (risk girdileri + kontrol
  // listesi) — kaynak EXISTING_RISK veya HYPOTHETICAL fark etmez. "Reset" işlemi
  // GERÇEK envanteri değil, yalnızca bu kaydı hedefler.
  initialStateSnapshot Json

  // Ham risk girdileri (1-5)
  naturalProbability Int

  // İş etkisi bileşenleri (%30/%30/%20/%20)
  finansalEtki     Int?
  itibarEtkisi     Int?
  regulasyonEtkisi Int?
  musteriEtkisi    Int?

  // BT/InfoSec etkisi bileşenleri (%35/%30/%35)
  gizlilikEtkisi        Int?
  butunlukEtkisi        Int?
  erisilebilirlikEtkisi Int?

  // İki grup OTOMATİK BİRLEŞTİRİLMEZ — kullanıcı açıkça hangisinin nihai etki
  // olarak kullanılacağını seçer (eksik metodoloji kararı, bkz. plan).
  finalImpactChoice SimFinalImpactChoice

  // Artık risk: motor bir ÖNERİ üretir (non-authoritative); kullanıcı gerekçeli
  // biçimde override edebilir. Öneri her zaman ayrıca saklanır, asla atılmaz.
  residualOverrideProbability Int?
  residualOverrideImpact      Int?
  residualOverrideReason      String? @db.Text
  residualIsOverridden        Boolean @default(false)

  controls  RiskSimulationControl[]
  actions   RiskSimulationAction[]
  transfers RiskSimulationTransfer[]

  createdBy   User   @relation("RiskSimScenarioCreatedBy", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([simulationId])
  @@index([sourceRiskId])
  @@index([methodologyVersionId])
}

enum SimP1 {
  MANUEL
  BT_MANUEL
  OTOMATIK
}

enum SimP2 {
  TESPIT_EDICI
  DUZELTICI
  ONLEYICI
}

enum SimP3 {
  IZ_KAYDI_YOK
  KULLANICI_SIFRE_SES_EMAIL
  SISTEM_LOG_ISLAK_IMZA
  ELEKTRONIK_IMZA
}

enum SimP4 {
  YOK
  AYNI_EKIP
  FARKLI_EKIP
  HER_IKISI
}

enum SimP5 {
  YOK
  DUZENSIZ_UST_AMIR
  DUZENLI_UST_AMIR
  FARKLI_BIRIM_GOZETIM
}

enum SimKtsMode {
  FROM_TEST
  MANUAL
}

enum SimImpactArea {
  PROBABILITY
  IMPACT
  BOTH
}

model RiskSimulationControl {
  id         String                 @id @default(cuid())
  scenario   RiskSimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String

  // Gerçek Control.id referansı (FK DEĞİL — snapshot bağımsızlığı kasıtlı).
  sourceControlId String?
  name            String
  description     String? @db.Text

  p1 SimP1
  p2 SimP2
  p3 SimP3
  p4 SimP4
  p5 SimP5

  // KTS: gerçek onaylı bir test sonucundan mı, yoksa yalnızca-simülasyon
  // "hipotetik" bir değerden mi geliyor — ikisi UI'da açıkça ayrılır.
  ktsMode         SimKtsMode
  ktsManualValue  Float? // 0-100, ktsMode=MANUAL ise
  ktsSourceTestId String? // gerçek ControlTest.id referansı, ktsMode=FROM_TEST ise

  // 0-1 oranı. Aynı senaryodaki kontrollerin ağırlık toplamı %100'ü aşamaz;
  // eksik kalan pay "kontrolsüz pay" olarak ayrı gösterilir, otomatik büyütülmez.
  weight     Float
  impactArea SimImpactArea

  sortOrder Int @default(0)

  actions RiskSimulationAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scenarioId])
  @@index([sourceControlId])
}

enum SimActionEffectMode {
  P1P5_KTS
  TARGET_KEP
}

model RiskSimulationAction {
  id         String                 @id @default(cuid())
  scenario   RiskSimulationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId String

  // Gerçek Action.id referansı, aksiyon gerçek bir aksiyondan başladıysa.
  sourceActionId String?

  targetControl      RiskSimulationControl @relation(fields: [targetControlSimId], references: [id], onDelete: Cascade)
  targetControlSimId String

  name        String
  description String? @db.Text

  effectMode SimActionEffectMode

  // effectMode=P1P5_KTS: yalnızca değişecek alanlar doldurulur (null = değişmiyor)
  targetP1  SimP1?
  targetP2  SimP2?
  targetP3  SimP3?
  targetP4  SimP4?
  targetP5  SimP5?
  targetKts Float?

  // effectMode=TARGET_KEP: doğrudan hedef KEP — asla gerçek P1-P5 kaynaklı bir
  // skormuş gibi sunulmaz, gerekçe zorunlu.
  targetKep       Float?
  targetKepReason String? @db.Text

  isApplied Boolean @default(false)
  // Aynı kontrolün aynı alanını hedefleyen birden fazla aksiyon çakıştığında
  // çözüm için kullanıcının belirlediği açık öncelik sırası.
  priority  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scenarioId])
  @@index([targetControlSimId])
}

model RiskSimulationTransfer {
  id         String                 @id @default(cuid())
  scenario   RiskSimulationScenario @relation(fields: [scenarioId], references: [id])
  scenarioId String

  transferId                String @unique // TRF-YYYY-XXXX
  // İdempotency: aynı senaryo+sürüm için tekrarlanan/eşzamanlı aktarım isteği
  // mevcut kaydı döner, mükerrer gerçek kayıt asla oluşturmaz.
  scenarioVersionAtTransfer Int

  performedBy   User     @relation("RiskSimTransferPerformedBy", fields: [performedById], references: [id])
  performedById String
  performedAt   DateTime @default(now())

  // { createdRiskId?, updatedRiskId?, createdControlIds[], updatedControlIds[],
  //   createdMappingIds[], removedMappingIds[], createdActionIds[], createdFindingIds[] }
  resultSummary Json

  createdAt DateTime @default(now())

  @@unique([scenarioId, scenarioVersionAtTransfer])
  @@index([scenarioId])
}
