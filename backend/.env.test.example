# E2E testleri için ortam — `cp .env.test.example .env.test`
# Test DB: docker-compose.test.yml (127.0.0.1:55432). "localhost" yerine 127.0.0.1
# kullanılır; yerel kurulu bir PostgreSQL'in 5432 ile çakışması bu porttan dolayı olmaz.
# test/helpers/db-guard.js: E2E_TEST_DATABASE=1 + izin verilen DB adı (grc_db_test) +
# izin verilen host:port (127.0.0.1:55432) — biri eksikse testler veriye dokunmadan durur.
E2E_TEST_DATABASE=1
DATABASE_URL="postgresql://grc_test:grc_test@127.0.0.1:55432/grc_db_test?schema=public"
JWT_SECRET="test-only-jwt-secret"
JWT_REFRESH_SECRET="test-only-jwt-refresh-secret"
NODE_ENV=test
# AI testleri dış servise ÇIKMAZ: sohbet ve embedding istemcileri taklit edilir;
# test/helpers/network-guard.ts beklenmeyen dış çağrıyı engeller ve testi başarısız sayar.
AI_BASE_URL=http://127.0.0.1:9/v1  # taklit istemciler devre dışı kalırsa bile yerel, erişilemez adres
AI_API_KEY=e2e-offline
