# GRC Backend Environment Configuration
# Copy this file to .env and update the values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grc_db?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Swagger (/api/docs) — development'ta varsayılan açık. Production'da API
# şemasının herkese açık kalmaması için varsayılan kapalıdır; yalnızca
# ihtiyaç hâlinde ve erişimi ayrıca kısıtlayarak (IP/VPN vb.) true yapın.
# SWAGGER_ENABLED=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Hata izleme (self-hosted Sentry) — boş bırakılırsa devre dışı kalır.
# Kurulum: https://develop.sentry.dev/self-hosted/ (docker-compose ile ayrı kurulum gerekir)
# SENTRY_DSN=http://xxxxx@sentry.kurumunuz.local/1

# ─── Yapay Zeka Destekli Modüller (Kontrol Testi Asistanı) ───────────────────
# AI_API_KEY boş veya AI_ENABLED=false ise modül tamamen kapalı kalır
# (menü, panel ve butonlar gizlenir; endpoint'ler 503 döner).
AI_ENABLED=false
AI_API_KEY=
# OpenAI-uyumlu uç nokta. NVIDIA NIM bulut varsayılan; kurum içi NIM için
# bu adresi kendi sunucunuza çevirin — kod değişmez.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Model ID'leri: Ayarlar sayfası → "Canlı model listesini doğrula" ile teyit edin.
# (nemotron-3-ultra-550b-a55b daha güçlü ama ücretsiz katmanda çok yavaş.)
AI_HEAVY_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_LIGHT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AI_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Kontrol & Kanıt Değerlendirme için özel model (opsiyonel; boşsa VISION→HEAVY).
AI_EVAL_MODEL=
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=180000

# ─── Otomatik Takip Üretimi (cron) ───────────────────────────────────────────
# Süresi geçmiş, açık takibi olmayan aksiyonlar için periyodik takip üretimi.
# VARSAYILAN KAPALI — üretimde etkinleştirmek ayrı bir deployment kararıdır.
FOLLOWUP_CRON_ENABLED=false
# Cron ifadesi (varsayılan: her gün 08:00) ve saat dilimi.
FOLLOWUP_CRON_EXPRESSION=0 8 * * *
FOLLOWUP_CRON_TZ=Europe/Istanbul
